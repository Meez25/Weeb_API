# Example .env file for production
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# Django Secret Key - Generate a new one for production
# You can generate one using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-super-secret-key-here-change-this

# Database Configuration (PostgreSQL recommended)
DB_NAME=weebapi_db
DB_USER=weebapi_user
DB_PASSWORD=your-database-password-here
DB_HOST=localhost
DB_PORT=5432

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password-or-app-password
SERVER_EMAIL=noreply@yourdomain.com

# Redis Configuration (optional, for caching)
REDIS_URL=redis://127.0.0.1:6379/1

# Domain Configuration
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL/Certificate paths (if using self-signed or custom certificates)
SSL_CERTIFICATE_PATH=/etc/ssl/certs/your-cert.crt
SSL_CERTIFICATE_KEY_PATH=/etc/ssl/private/your-key.key
